# RepoPilot AI Backend Configuration

# Application
APP_NAME=RepoPilot AI
APP_ENV=development
DEBUG=true
PORT=8000
HOST=127.0.0.1

# Database (SQLite default for local development)
DATABASE_URL=sqlite:///./repopilot.db

# Storage (Directory path where uploaded archives and extracted files are stored, outside public web directory)
STORAGE_DIR=./storage

# Security Limits
MAX_UPLOAD_SIZE_BYTES=52428800           # 50 MB
MAX_ARCHIVE_ENTRIES=10000                 # Maximum files/folders allowed inside ZIP
MAX_ARCHIVE_EXPANDED_BYTES=209715200     # 200 MB maximum uncompressed size
MAX_ARCHIVE_FILE_BYTES=26214400          # 25 MB maximum single uncompressed file size
MAX_COMPRESSION_RATIO=50.0               # Maximum compression ratio (uncompressed/compressed) to reject zip bombs

# Analysis Limits
MAX_TRAVERSAL_DEPTH=15                   # Maximum directory depth to inspect
MAX_FILE_COUNT=5000                      # Maximum files to process in a repository
MAX_ANALYSIS_FILE_BYTES=2097152          # 2 MB maximum single file size for content analysis
MAX_TOTAL_ANALYSIS_BYTES=52428800        # 50 MB total content bytes read per repository scan

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Day 2 Execution Worker & Docker Sandbox
WORKER_BACKEND=auto                       # "docker", "fake", or "auto" (detects Docker availability)
DOCKER_BASE_IMAGE=python:3.11-slim       # Pinned sandbox container image
EXECUTION_TIMEOUT_SECONDS=60             # Wall-clock timeout for test execution
SETUP_TIMEOUT_SECONDS=120                # Timeout for dependency installation
EXECUTION_CPU_LIMIT=1.0                  # Max CPUs allocated to worker
EXECUTION_MEMORY_LIMIT=512m              # Max memory allocated to worker
EXECUTION_PIDS_LIMIT=100                 # Max processes to prevent fork bombs
MAX_LOG_OUTPUT_BYTES=512000              # 500 KB log truncation limit

# Day 3 LLM Diagnosis & Patch Engine
LLM_PROVIDER=groq                        # Use groq for real diagnosis; fake is only for deterministic tests.
GROQ_API_KEY=your_groq_api_key_here      # Create a key at https://console.groq.com/; keep private.
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=                           # Optional alternative when LLM_PROVIDER=gemini.
OPENAI_API_KEY=                          # Optional alternative OpenAI key
LLM_MODEL=gemini-3.8-flash               # Model name
LLM_TIMEOUT_SECONDS=60                   # Timeout for LLM provider response
LLM_MAX_RETRIES=3                        # Max retry attempts for transient API errors


